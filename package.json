{
  "name": "nexora-desktop",
  "productName": "Nexora",
  "version": "1.0.0",
  "description": "Nexora project management — desktop app",
  "author": "Anwar <dev.anwar.official@gmail.com>",
  "main": "main.js",
  "private": true,
  "scripts": {
    "copy-web": "node scripts/copy-web.js",
    "start": "npm run copy-web && electron .",
    "dev": "cross-env NEXORA_WEB_URL=http://localhost:5173 electron .",
    "dist": "npm run copy-web && electron-builder",
    "dist:win": "npm run copy-web && electron-builder --win",
    "dist:mac": "npm run copy-web && electron-builder --mac",
    "dist:linux": "npm run copy-web && electron-builder --linux"
  },
  "build": {
    "appId": "com.nexora.desktop",
    "productName": "Nexora",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
